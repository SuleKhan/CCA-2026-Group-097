import time

# Allocate a large buffer and repeatedly touch it.
# Keep this below total memory to avoid swapping.
SIZE_MB = 512
STRIDE = 4096

buf = bytearray(SIZE_MB * 1024 * 1024)
i = 0

while True:
    for off in range(0, len(buf), STRIDE):
        buf[off] = (buf[off] + 1) & 0xFF
    i += 1

PYEOF

