    >/tmp/interference_core3.out 2>/tmp/interference_core3.err &

echo $! > ~/interference_core3.pid

sleep 0.5

if kill -0 $(cat ~/interference_core3.pid) 2>/dev/null; then
    echo "started pid=$(cat ~/interference_core3.pid)"
else
    echo "failed to start"
    exit 1
fi
'
